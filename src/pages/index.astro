---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Benefits from '../components/Benefits.astro';
import ProductCards from '../components/ProductCards.astro';
import HoneySorts from '../components/HoneySorts.astro';
import Pricing from '../components/Pricing.astro';
import Audience from '../components/Audience.astro';
import HowItWorks from '../components/HowItWorks.astro';
import LeadForm from '../components/LeadForm.astro';
import DeliverySummary from '../components/DeliverySummary.astro';
import AboutApiary from '../components/AboutApiary.astro';
import Gallery from '../components/Gallery.astro';
import Testimonials from '../components/Testimonials.astro';
import FAQ from '../components/FAQ.astro';
import ContactChannels from '../components/ContactChannels.astro';
---
<BaseLayout title="Купити мед з власної пасіки — Медова Банка, Сумщина" description="Свіжий мед 2026 з власної пасіки на Сумщині: липовий, соняшниковий, різнотрав'я. Без цукру й добавок. Замовити мед з доставкою, опт від 20 л.">
  <Hero />
  <Benefits />
  <ProductCards />
  <HoneySorts />
  <Pricing />
  <Audience />
  <HowItWorks />
  <section id="order" class="section">
    <div class="container">
      <h2 class="section-title">Хочете замовити мед?</h2>
      <p class="section-subtitle">Ми допоможемо з вибором і підкажемо — заповніть форму й отримайте консультацію експерта.</p>
      <div class="lead-wrap">
        <LeadForm source="section" />
      </div>
    </div>
  </section>
  <DeliverySummary />
  <AboutApiary />
  <Gallery />
  <Testimonials />
  <FAQ limit={6} />
  <ContactChannels />
</BaseLayout>

<style is:global>
  .lead-wrap { max-width: 560px; margin: 0 auto; }
</style>
