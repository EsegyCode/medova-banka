---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
import { faqItems } from '../data/faq.ts';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<BaseLayout title="Питання та відповіді про мед | Медова Банка" description="Відповіді на часті питання про мед: як замовити, свіжість, склад, кристалізація, зберігання, доставка, оплата, знижки.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </Fragment>
  <section class="section">
    <div class="container">
      <h1 style="text-align:center;color:var(--color-brand);">Питання та відповіді про мед</h1>
    </div>
  </section>
  <FAQ showLink={false} />
  <section id="order" class="section">
    <div class="container">
      <h2 class="section-title">Хочете замовити мед?</h2>
      <p class="section-subtitle">Заповніть форму й отримайте консультацію експерта.</p>
      <div class="lead-wrap"><LeadForm source="section" /></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .lead-wrap { max-width: 560px; margin: 0 auto; }
</style>
