---
import BaseLayout from '../layouts/BaseLayout.astro';
import FAQ from '../components/FAQ.astro';
import LeadForm from '../components/LeadForm.astro';
---
<BaseLayout title="Питання та відповіді про мед | Медова Банка" description="Відповіді на часті питання про мед: як замовити, свіжість, склад, кристалізація, зберігання, доставка, оплата, знижки.">
  <section class="section">
    <div class="container">
      <h1 style="text-align:center;color:var(--color-brand);">Питання та відповіді про мед</h1>
      <p style="max-width:820px;margin:0 auto 1rem;color:var(--color-text-muted);text-align:center;">Тут зібрані відповіді на часті питання про мед: як замовити і оплатити, як зберігати, чому мед кристалізується, як відрізнити натуральний мед, різницю між сортами і як отримати замовлення в Сумах чи іншому місті України. Якщо не знайшли відповіді — зателефонуйте нам або напишіть у Telegram-бот, і ми допоможемо. Зручно, коли хочете купити натуральний мед з пасіки і заздалегідь усе зрозуміти.</p>
    </div>
  </section>
  <FAQ />
  <section id="order" class="section">
    <div class="container">
      <h2 class="section-title">Хочете замовити мед?</h2>
      <p class="section-subtitle">Заповніть форму й отримайте консультацію експерта.</p>
      <div class="lead-wrap"><LeadForm source="section" /></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .lead-wrap { max-width: 560px; margin: 0 auto; }
</style>
