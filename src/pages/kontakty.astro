---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactChannels from '../components/ContactChannels.astro';
import LeadForm from '../components/LeadForm.astro';
---
<BaseLayout title="Контакти — Медова Банка, Сумський район" description="Контакти Медова Банка: телефон +38 (099) 701-12-56, email, Telegram-бот. Графік роботи щодня 7:00–21:00. Самовивіз у Сумах.">
  <section class="section">
    <div class="container content-page">
      <h1>Контакти</h1>
      <div class="contact-info">
        <p><strong>Телефон:</strong> <a href="tel:+380997011256">+38 (099) 701-12-56</a></p>
        <p><strong>Email:</strong> <a href="mailto:medovabanka@gmail.com">medovabanka@gmail.com</a></p>
        <p><strong>Telegram:</strong> <a href="https://t.me/medovabanka_bot" target="_blank" rel="noopener noreferrer">@medovabanka_bot</a></p>
        <p><strong>Графік роботи:</strong> щодня з 7:00 до 21:00</p>
        <p><strong>Регіон:</strong> Сумський район, Сумщина. Доставка по всій Україні.</p>
        <p><strong>Пункт самовивозу:</strong> м. Суми, вул. Збройних Сил України (номер будинку — TODO)</p>
      </div>
    </div>
  </section>
  <ContactChannels />
  <section id="order" class="section section-alt">
    <div class="container">
      <h2 class="section-title">Хочете замовити мед?</h2>
      <div class="lead-wrap"><LeadForm source="section" /></div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .content-page { max-width: 820px; margin-inline: auto; }
  .content-page h1 { color: var(--color-brand); margin-bottom: 1.5rem; }
  .contact-info p { margin-bottom: .5rem; color: var(--color-text-muted); }
  .contact-info a { color: var(--color-brand); font-weight: 600; }
  .lead-wrap { max-width: 560px; margin: 0 auto; }
</style>
