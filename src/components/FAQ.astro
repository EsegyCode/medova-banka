---
import { faqItems, faqGroups } from '../data/faq.ts';
interface Props { schema?: boolean; }
const { schema = true } = Astro.props;
const orderedItems = faqGroups.flatMap((g) => faqItems.filter((it) => it.group === g.id));
const groups = faqGroups.map((g) => ({ ...g, items: faqItems.filter((it) => it.group === g.id) })).filter((g) => g.items.length);
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: orderedItems.map((it) => ({
    '@type': 'Question',
    name: it.q,
    acceptedAnswer: { '@type': 'Answer', text: it.a },
  })),
};
---
<section id="faq" class="section-alt" aria-labelledby="faq-title">
  <div class="container">
    <h2 id="faq-title" class="section-title">Питання та відповіді</h2>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
    {groups.map((g) => (
      <div class="faq-group">
        <h3 class="faq-group-title">{g.title}</h3>
        <div class="faq-list">
          {g.items.map((it) => (
            <details class="faq-item">
              <summary>{it.q}</summary>
              <div class="faq-answer">{it.a}</div>
            </details>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .faq-group { margin-top: 2rem; }
  .faq-group:first-child { margin-top: 1rem; }
  .faq-group-title { font-family: var(--font-heading, inherit); color: var(--color-brand); text-align: center; margin-bottom: 1rem; }
  .faq-list { max-width: 840px; margin: 1.5rem auto; display: grid; gap: .75rem; }
  .faq-item { background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-btn); padding: 1rem 1.25rem; box-shadow: var(--shadow-card); }
  .faq-item summary { cursor: pointer; font-weight: 600; color: var(--color-brand); list-style: none; }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item[open] summary { margin-bottom: .5rem; }
  .faq-answer { color: var(--color-text-muted); }
  .faq-more { text-align: center; margin-top: 1.5rem; }
</style>
