---
import { galleryItems } from '../data/gallery.ts';
---
<section id="gallery" class="section-alt">
  <div class="container">
    <h2 class="section-title">Пасіка, мед і наші будні</h2>
    <div class="gallery-grid">
      {galleryItems.map((g) => (
        <figure class="gallery-item">
          <img src={g.src} alt={g.alt} width="400" height="300" loading="lazy" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .gallery-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; }
  @media (max-width: 480px) { .gallery-grid { grid-template-columns: 1fr; } }
  @media (min-width: 481px) and (max-width: 900px) { .gallery-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 901px) { .gallery-grid { grid-template-columns: repeat(3, 1fr); } }
  .gallery-item { margin: 0; }
  .gallery-item img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; object-position: center; border-radius: var(--radius-card); display: block; }
</style>