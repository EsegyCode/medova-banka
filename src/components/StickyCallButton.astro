<button class="sticky-order" type="button" data-open-modal aria-label="Замовити мед">
  Замовити
</button>

<style>
  .sticky-order {
    position: fixed;
    bottom: 16px;
    right: 16px;
    z-index: 999;
    min-height: var(--tap-min);
    padding: .75rem 1.5rem;
    border-radius: 999px;
    background: var(--color-cta);
    color: var(--color-text);
    border: none;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 8px 24px rgba(242, 140, 0, 0.4);
    animation: pulse 2s infinite;
  }
  @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
  @media (prefers-reduced-motion: reduce) { .sticky-order { animation: none; } }
  @media (max-width: 899px) {
    .sticky-order {
      left: 0; right: 0; bottom: 0;
      border-radius: 0;
      width: 100%;
      animation: none;
    }
  }
</style>
