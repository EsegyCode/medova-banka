<button class="sticky-order" type="button" data-open-modal aria-label="Замовити мед">
  <svg viewBox="0 0 24 24" width="40" height="40" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .3 1.9.6 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.3 1.8.5 2.8.6a2 2 0 0 1 1.7 2.1z" /></svg>
</button>

<style>
  .sticky-order {
    position: fixed;
    bottom: calc(24px + env(safe-area-inset-bottom));
    right: 24px;
    z-index: 1000;
    width: 86px;
    height: 86px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-cta);
    color: #1A1A1A;
    border: none;
    cursor: pointer;
    box-shadow: 0 12px 32px rgba(242, 140, 0, 0.45);
    animation: pulse 2s infinite;
  }
  .sticky-order:hover { background: var(--color-cta-dark); color: #fff; }
  .sticky-order:focus-visible { outline: 3px solid var(--color-brand); outline-offset: 3px; }
  @keyframes pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.05); } }
  @media (prefers-reduced-motion: reduce) { .sticky-order { animation: none; } }
  @media (max-width: 899px) {
    .sticky-order { width: 74px; height: 74px; bottom: calc(16px + env(safe-area-inset-bottom)); right: 16px; }
    .sticky-order svg { width: 34px; height: 34px; }
  }
</style>
