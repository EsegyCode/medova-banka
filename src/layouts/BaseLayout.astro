---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallButton from '../components/StickyCallButton.astro';
import LeadForm from '../components/LeadForm.astro';

const {
  title = 'Медова Банка — купити натуральний мед з власної пасіки на Сумщині',
  description = 'Свіжий мед 2026 з власної пасіки на Сумщині: липовий, соняшниковий, різнотрав\'я. Без цукру й добавок. Замовити мед з доставкою, опт від 20 л.',
  canonical,
  schema,
} = Astro.props;
const site = (Astro.site ? Astro.site.toString() : 'https://medova-banka.shop').replace(/\/$/, '');
const pageUrl = canonical ? new URL(canonical, site + '/').toString() : new URL(Astro.url.pathname, site + '/').toString();
const ogImage = `${site}/og-image.jpg`;

const localBusiness = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'Медова Банка',
  url: site,
  telephone: '+380997011256',
  image: ogImage,
  description,
  areaServed: 'Сумський район, Сумська область; доставка по Україні',
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '07:00',
    closes: '21:00',
  }],
};
const ld = schema || localBusiness;
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={pageUrl} />
  <meta property="og:locale" content="uk_UA" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <slot name="head" />
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <a class="skip-link" href="#main">Перейти до контенту</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyCallButton />
  <div class="lead-modal" id="lead-modal" hidden aria-hidden="true">
    <div class="lead-modal__backdrop" data-close-modal></div>
    <div class="lead-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title">
      <button class="lead-modal__close" type="button" data-close-modal aria-label="Закрити">×</button>
      <h2 id="lead-modal-title" class="section-title">Хочете замовити мед?</h2>
      <p class="section-subtitle">Ми допоможемо з вибором і підкажемо — заповніть форму й отримайте консультацію експерта.</p>
      <LeadForm source="modal" />
    </div>
  </div>
  <script is:inline>
    (function () {
      var modal = document.getElementById('lead-modal');
      if (!modal) return;
      function openModal(product) {
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelectorAll('input[name="product"]').forEach(function (i) { i.value = product || ''; });
        var first = modal.querySelector('input[name="name"]');
        if (first) first.focus();
      }
      function closeModal() {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      document.querySelectorAll('[data-open-modal]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          if (btn.getAttribute('href') === '#order') return;
          e.preventDefault();
          openModal(btn.getAttribute('data-product') || '');
        });
      });
      modal.addEventListener('click', function (e) {
        if (e.target && e.target.hasAttribute && e.target.hasAttribute('data-close-modal')) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });
    })();
  </script>
</body>
</html>

<style is:global>
  .lead-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .lead-modal[hidden] { display: none; }
  .lead-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
  .lead-modal__dialog { position: relative; background: var(--color-surface); border-radius: var(--radius-card); padding: 1.75rem; width: 100%; max-width: 520px; max-height: 90vh; overflow: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  .lead-modal__close { position: absolute; top: .6rem; right: .8rem; background: none; border: none; font-size: 2rem; line-height: 1; cursor: pointer; color: var(--color-text-muted); }
</style>
