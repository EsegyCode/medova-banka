---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCallButton from '../components/StickyCallButton.astro';
import LeadForm from '../components/LeadForm.astro';
import SEO from '../components/SEO.astro';
import CookieBanner from '../components/CookieBanner.astro';
import JsonLd from '../components/JsonLd.astro';
import { site as siteData } from '../data/site.ts';

const {
  title = 'Медова Банка — купити натуральний мед з власної пасіки на Сумщині',
  description = 'Свіжий мед 2026 з власної пасіки на Сумщині: липовий, соняшниковий, різнотрав\'я. Без цукру й добавок. Замовити мед з доставкою, опт від 20 л.',
  canonical,
  schema,
  image,
} = Astro.props;
const ogImageMap: Record<string, string> = {
  '/': '/og/og-home.png',
  '/pro-pasiku/': '/og/og-about.png',
  '/pytannya-vidpovidi/': '/og/og-faq.png',
  '/polityka-konfidentsiinosti/': '/og/og-privacy.png',
  '/publichna-oferta/': '/og/og-terms.png',
  '/polityka-cookie/': '/og/og-cookies.png',
  '/dostavka-ta-oplata/': '/og/og-delivery.png',
  '/kontakty/': '/og/og-contacts.png',
  '/karta-saitu/': '/og/og-sitemap.png',
};
const ogImageFallback = ogImageMap[Astro.url.pathname] || '/og/og-default.png';
const siteOrigin = (Astro.site ? Astro.site.toString() : siteData.siteUrl).replace(/\/$/, '');
const pageUrl = canonical ? new URL(canonical, siteOrigin + '/').toString() : new URL(Astro.url.pathname, siteOrigin + '/').toString();

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: siteData.siteName,
  url: siteOrigin,
  logo: `${siteOrigin}/icon-512.png`,
  image: `${siteOrigin}/logo-medova-banka.jpg`,
  telephone: siteData.phone,
  email: siteData.email,
  description,
  areaServed: siteData.country,
  address: {
    '@type': 'PostalAddress',
    addressLocality: siteData.addressLocality,
    addressRegion: siteData.addressRegion,
    addressCountry: siteData.country,
  },
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday','Tuesday','Wednesday','Thursday','Friday','Saturday','Sunday'],
    opens: '07:00',
    closes: '21:00',
  }],
  sameAs: [siteData.telegramUrl],
};
const webSite = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteData.siteName,
  url: siteOrigin,
  inLanguage: 'uk',
};
---
<!doctype html>
<html lang="uk">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/favicon.ico?v=2" sizes="48x48" />
  <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png?v=2" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
  <meta name="theme-color" content="#6B3E1B" />
  <SEO title={title} description={description} canonical={canonical} image={image || ogImageFallback} />
  <slot name="head" />
  <JsonLd data={organization} />
  <JsonLd data={webSite} />
  {schema && <JsonLd data={schema} />}
</head>
<body>
  <a class="skip-link" href="#main">Перейти до контенту</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <StickyCallButton />
  <CookieBanner />
  <div class="lead-modal" id="lead-modal" hidden aria-hidden="true">
    <div class="lead-modal__backdrop" data-close-modal></div>
    <div class="lead-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="lead-modal-title">
      <button class="lead-modal__close" type="button" data-close-modal aria-label="Закрити">×</button>
      <h2 id="lead-modal-title" class="section-title">Хочете замовити мед?</h2>
      <p class="section-subtitle">Ми допоможемо з вибором і підкажемо — заповніть форму й отримайте консультацію експерта.</p>
      <LeadForm source="modal" />
    </div>
  </div>
  <script is:inline>
    (function () {
      var modal = document.getElementById('lead-modal');
      if (!modal) return;
      function openModal(product) {
        modal.hidden = false;
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelectorAll('input[name="product"]').forEach(function (i) { i.value = product || ''; });
        var first = modal.querySelector('input[name="name"]');
        if (first) first.focus();
      }
      function closeModal() {
        modal.hidden = true;
        modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }
      document.querySelectorAll('[data-open-modal]').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
          if (btn.getAttribute('href') === '#order') return;
          e.preventDefault();
          openModal(btn.getAttribute('data-product') || '');
        });
      });
      modal.addEventListener('click', function (e) {
        if (e.target && e.target.hasAttribute && e.target.hasAttribute('data-close-modal')) closeModal();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && !modal.hidden) closeModal();
      });
    })();
  </script>
</body>
</html>

<style is:global>
  .lead-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: 1rem; }
  .lead-modal[hidden] { display: none; }
  .lead-modal__backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
  .lead-modal__dialog { position: relative; background: var(--color-surface); border-radius: var(--radius-card); padding: 1.75rem; width: 100%; max-width: min(520px, calc(100vw - 32px)); max-height: calc(100dvh - 96px); overflow-y: auto; box-shadow: 0 20px 60px rgba(0,0,0,0.3); }
  .lead-modal__close { position: absolute; top: .6rem; right: .8rem; background: none; border: none; font-size: 2rem; line-height: 1; cursor: pointer; color: var(--color-text-muted); }
</style>
